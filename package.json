{
  "name": "meg-financial-os",
  "version": "1.3.0-project-phoenix",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/core",
    "packages/ui",
    "packages/shared",
    "packages/analytics",
    "packages/intelligence",
    "apps/api",
    "packages/database"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "build": "npm-run-all build:web build:api",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "check": "npm-run-all test build",
    "test": "npm-run-all test:core test:imports test:notifications test:auth test:cors test:commercial test:app-state test:finance test:legacy-finance test:legacy-state-patch test:cloud-write-ahead test:durable-outbox test:cloud-state-properties test:global-cloud-confirmation test:state-recovery test:recovery-center test:activity-log test:currency-mask test:brl-money-audit test:app-update-release test:android-update-flow test:transaction-editor test:transaction-status-policy test:web-runtime-stability test:adaptive-cards test:layout-reform test:stable-grid-filters test:recurring-transactions test:negative-expenses test:transaction-batch-theme test:android-biometric test:executive-pdf",
    "test:core": "node packages/core/src/tests/core.test.js",
    "test:imports": "npm --workspace apps/api run test:imports",
    "test:notifications": "npm --workspace apps/api run test:notifications",
    "test:auth": "npm --workspace apps/api run test:auth",
    "test:cors": "npm --workspace apps/api run test:cors",
    "test:commercial": "npm --workspace apps/api run test:commercial",
    "test:app-state": "npm --workspace apps/api run test:app-state",
    "test:finance": "npm --workspace apps/api run test:finance",
    "test:legacy-finance": "node apps/web/src/legacy-finance.test.js",
    "test:legacy-state-patch": "node apps/web/src/legacy-state-patch.test.js",
    "test:cloud-write-ahead": "node apps/web/src/cloud-write-ahead-core.test.js",
    "test:durable-outbox": "node --test apps/web/src/durable-outbox-core.test.js",
    "test:cloud-state-properties": "node apps/web/src/cloud-state-properties-core.test.js",
    "test:global-cloud-confirmation": "node apps/web/src/global-cloud-confirmation.test.js",
    "test:state-recovery": "node apps/web/src/state-recovery-core.test.js",
    "test:recovery-center": "node apps/web/src/recovery-center-core.test.js",
    "test:activity-log": "node apps/web/src/activity-log-core.test.js",
    "test:currency-mask": "node apps/web/src/currency-input-mask.test.js",
    "test:brl-money-audit": "node apps/web/src/brl-money-audit.test.js",
    "test:app-update-release": "node apps/web/src/app-update-release-core.test.js",
    "test:android-update-flow": "node apps/web/src/android-update-flow.test.js",
    "test:transaction-editor": "node apps/web/src/transaction-editor.test.js",
    "test:transaction-status-policy": "node apps/web/src/transaction-status-policy.test.js",
    "test:web-runtime-stability": "node apps/web/src/web-runtime-stability.test.js",
    "test:adaptive-cards": "node apps/web/src/adaptive-card-typography.test.js",
    "test:layout-reform": "node apps/web/src/layout-reform.test.js",
    "test:stable-grid-filters": "node apps/web/src/stable-grid-filters.test.js",
    "test:recurring-transactions": "node apps/web/src/recurring-transactions.test.js",
    "test:negative-expenses": "node apps/web/src/negative-expense-amounts.test.js",
    "test:transaction-batch-theme": "node apps/web/src/transaction-batch-theme.test.js",
    "test:android-biometric": "node apps/web/src/native-biometric-login.test.js",
    "test:executive-pdf": "node apps/web/src/executive-financial-report-pdf.test.js",
    "lint": "echo \"Lint configurado para próxima sprint\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "start:api": "npm --workspace apps/api run start",
    "db:generate": "npm --workspace packages/database run db:generate",
    "db:push": "npm --workspace packages/database run db:push",
    "db:push:production": "npm --workspace packages/database run db:push:production",
    "db:prepare:production": "npm --workspace packages/database run db:prepare:production",
    "db:seed": "npm --workspace packages/database run db:seed",
    "db:studio": "npm --workspace packages/database run db:studio",
    "db:generate:legacy": "npm --workspace packages/database run db:generate:legacy",
    "db:migrate:supabase": "npm --workspace packages/database run db:migrate:supabase",
    "db:import:basemeg": "npm --workspace packages/database run db:import:basemeg --",
    "phoenix:setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "npm-run-all": "^4.1.5"
  }
}
